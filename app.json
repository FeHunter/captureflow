{
  "expo": {
    "name": "CaptureFlow",
    "slug": "captureflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "captureflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O CaptureFlow precisa acessar suas fotos para importar imagens e screenshots que você escolher.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.fehunter.captureflow",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.fehunter.captureflow"
    },
    "extra": {
      "eas": {
        "projectId": "369fefee-99ba-4362-99fa-911478ce1791"
      }
    }
  }
}
