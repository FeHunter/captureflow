{
  "expo": {
    "name": "CaptureFlow",
    "slug": "captureflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "captureflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.fehunter.captureflow",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.fehunter.captureflow"
    }
  }
}
