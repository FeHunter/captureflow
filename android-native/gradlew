#!/bin/sh
# Gradle startup script for POSIX shells.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit
JAVA_CMD=java
if [ -n "$JAVA_HOME" ]; then JAVA_CMD="$JAVA_HOME/bin/java"; fi
if ! command -v "$JAVA_CMD" >/dev/null 2>&1; then
  echo "Java was not found. Set JAVA_HOME to a JDK installation." >&2
  exit 1
fi
exec "$JAVA_CMD" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
